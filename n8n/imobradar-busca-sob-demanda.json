    {
      "id": "4937fcac-681b-41d4-ac75-b91f4a26c4a1",
      "name": "Montar pedido",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "27cb9248-7057-4f52-9fac-a8edd7fa8b39",
              "name": "prompt",
              "value": "={{ (() => {\n  const b = $('Webhook').first().json.body;\n  const oque = { venda: 'à venda', aluguel: 'para alugar (aluguel mensal)', temporada: 'para aluguel por temporada (diária)' }[b.finalidade] || 'à venda';\n  return `Você coleta anúncios imobiliários para o IMOBRADAR.\n\nTarefa: encontre anúncios ATIVOS de imóveis ${oque} no município de ${b.cidade}/PB (Paraíba, Brasil).\nPesquise em portais (OLX, ZAP Imóveis, VivaReal, Chaves na Mão, Imovelweb, MGF Imóveis) e em sites de imobiliárias e corretores da região. Faça buscas variadas: por tipo (casa, apartamento, terreno), por bairros e praias de ${b.cidade}, e por imobiliárias locais.\n\nRegras:\n- Só anúncios individuais: a URL precisa abrir UM imóvel, não uma página de listagem ou de busca.\n- Só imóveis localizados em ${b.cidade}/PB.\n- Não invente nada. Campo que não aparece na fonte fica null.\n- preco em reais, só número (ex.: 450000). area em m², só número.\n- fonte = nome do site onde o anúncio está (ex.: \"OLX\", \"ZAP Imóveis\", \"Imobiliária X\").\n- Traga o máximo que conseguir, até 60 anúncios, sem repetir a mesma URL.\n\nResponda SOMENTE com um array JSON, sem texto antes ou depois, neste formato:\n[{\"url\":\"\",\"titulo\":\"\",\"fonte\":\"\",\"tipo\":\"casa|casa_condominio|apartamento|cobertura|flat|terreno|chacara_sitio|comercial|outro\",\"preco\":null,\"bairro\":null,\"quartos\":null,\"suites\":null,\"banheiros\":null,\"vagas\":null,\"area_construida\":null,\"area_terreno\":null,\"piscina\":null,\"proximo_praia\":null,\"descricao\":null}]`;\n})() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "21bc6750-f2c6-4119-b07a-d294de7ecd55",
      "name": "Claude busca na web",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'claude-sonnet-5-5',\n  max_tokens: 16000,\n  tools: [{ type: 'web_search_20250305', name: 'web_search', max_uses: 12, user_location: { type: 'approximate', country: 'BR', region: 'Paraíba', timezone: 'America/Sao_Paulo' } }],\n  messages: [{ role: 'user', content: $json.prompt }]\n}) }}",
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Anthropic API"
        }
      }
    },
    {
      "id": "abc4eefe-6659-49bc-81c8-60d96cd46bae",
      "name": "Extrair anúncios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "jsCode": "// Junta os blocos de texto da resposta do Claude e extrai o array JSON de anúncios.\nconst resp = $input.first().json;\nconst texto = (resp.content || []).filter(b => b.type === 'text').map(b => b.text).join('\\n');\nlet lista = [];\nconst ini = texto.indexOf('['), fim = texto.lastIndexOf(']');\nif (ini >= 0 && fim > ini) {\n  try { lista = JSON.parse(texto.slice(ini, fim + 1)); } catch (e) { lista = []; }\n}\nconst b = $('Webhook').first().json.body;\nconst vistos = new Set();\nconst anuncios = (Array.isArray(lista) ? lista : [])\n  .filter(a => a && typeof a.url === 'string' && /^https?:\\/\\//i.test(a.url) && a.titulo)\n  .filter(a => { const k = a.url.split('#')[0]; if (vistos.has(k)) return false; vistos.add(k); return true; })\n  .map(a => ({\n    url: a.url, titulo: a.titulo, fonte: a.fonte || null, tipo: a.tipo || null,\n    finalidade: b.finalidade, cidade_ibge: b.cidade_ibge,\n    preco: a.preco, bairro: a.bairro, quartos: a.quartos, suites: a.suites, banheiros: a.banheiros,\n    vagas: a.vagas, area_construida: a.area_construida, area_terreno: a.area_terreno,\n    piscina: a.piscina, proximo_praia: a.proximo_praia, descricao: a.descricao,\n  }));\n\nconst uso = resp.usage || {};\nconst lotes = [];\nfor (let i = 0; i < anuncios.length; i += 100) lotes.push(anuncios.slice(i, i + 100));\nif (lotes.length === 0) return [{ json: { lote: [], total: 0, uso } }];\nreturn lotes.map(l => ({ json: { lote: l, total: anuncios.length, uso } }));"
      }
    },
